{
  "name": "@worldlibertyfinancial/agentpay",
  "version": "1.0.0",
  "description": "AgentPay command-line client and terminal UI for the AgentPay daemons",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "agentpay": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "ink": "^6.8.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
