{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/next-env.d.ts",
      "!**/node_modules",
      "!**/.next",
      "!**/.turbo",
      "!**/target",
      "!**/.serverless",
      "!**/coverage"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      // Vendored upstream QR encoder; keep byte-for-byte to simplify future syncs.
      "includes": ["skills/agentpay-sdk/scripts/vendor/qrcodegen.mjs"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
